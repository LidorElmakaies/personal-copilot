# Reference only — see backend/.env.example's header. Copy the lines below into backend/.env if
# filling it in var-by-var.

NODE_ENV=development
PORT=8001
# Must match Gateway's value exactly — Auth Service signs, Gateway verifies.
JWT_SECRET=change-me-to-a-long-random-value
# salt+pepper+SHA-256 — must stay identical across restarts or every existing password hash stops
# verifying.
PASSWORD_PEPPER=change-me-to-a-different-long-random-value
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_copilot
# OTEL_SERVICE_NAME=auth
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
