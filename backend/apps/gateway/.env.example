# Reference only — see backend/.env.example's header for how local dev vs. Docker Compose actually
# supply these. Copy the lines below into backend/.env if filling it in var-by-var.

NODE_ENV=development
PORT=8000
# Must match Auth Service's own JWT_SECRET exactly — Gateway verifies tokens it never signs.
JWT_SECRET=change-me-to-a-long-random-value
# Where Gateway forwards /auth/* — internal-only, never published to the host.
AUTH_SERVICE_URL=http://localhost:8001
# POST /telegram/link-code publishes to this and apps/telegram's reply arrives on a topic Gateway
# consumes itself (see event-schemas.md) — no direct call to apps/telegram at all.
KAFKA_BROKERS=localhost:9092
# OTEL_SERVICE_NAME=gateway
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
