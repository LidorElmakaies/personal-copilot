{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": { "tsConfigPath": "apps/gateway/tsconfig.app.json" }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": { "tsConfigPath": "apps/auth/tsconfig.app.json" }
    },
    "calendar": {
      "type": "application",
      "root": "apps/calendar",
      "entryFile": "main",
      "sourceRoot": "apps/calendar/src",
      "compilerOptions": { "tsConfigPath": "apps/calendar/tsconfig.app.json" }
    },
    "reminders": {
      "type": "application",
      "root": "apps/reminders",
      "entryFile": "main",
      "sourceRoot": "apps/reminders/src",
      "compilerOptions": { "tsConfigPath": "apps/reminders/tsconfig.app.json" }
    },
    "notifications": {
      "type": "application",
      "root": "apps/notifications",
      "entryFile": "main",
      "sourceRoot": "apps/notifications/src",
      "compilerOptions": { "tsConfigPath": "apps/notifications/tsconfig.app.json" }
    },
    "auth-kernel": {
      "type": "library",
      "root": "libs/auth-kernel",
      "entryFile": "index",
      "sourceRoot": "libs/auth-kernel/src",
      "compilerOptions": { "tsConfigPath": "libs/auth-kernel/tsconfig.lib.json" }
    },
    "otel": {
      "type": "library",
      "root": "libs/otel",
      "entryFile": "index",
      "sourceRoot": "libs/otel/src",
      "compilerOptions": { "tsConfigPath": "libs/otel/tsconfig.lib.json" }
    },
    "queue-contracts": {
      "type": "library",
      "root": "libs/queue-contracts",
      "entryFile": "index",
      "sourceRoot": "libs/queue-contracts/src",
      "compilerOptions": { "tsConfigPath": "libs/queue-contracts/tsconfig.lib.json" }
    },
    "queue-client": {
      "type": "library",
      "root": "libs/queue-client",
      "entryFile": "index",
      "sourceRoot": "libs/queue-client/src",
      "compilerOptions": { "tsConfigPath": "libs/queue-client/tsconfig.lib.json" }
    }
  }
}
