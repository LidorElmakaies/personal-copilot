# Shared local-dev defaults, read by every app's ConfigModule (npx nest start <app> from
# backend/). Copy to backend/.env. See docs/gateway/environment.md and docs/users/environment.md
# for what each variable does and why.

NODE_ENV=development

# ── Gateway ──────────────────────────────────────────────────────────────────────
# No PORT here — see docs/gateway/environment.md.
USERS_SERVICE_URL=http://localhost:8001
CALENDAR_SERVICE_URL=http://localhost:8002
NOTIFICATIONS_SERVICE_URL=http://localhost:8004
REMINDERS_SERVICE_URL=http://localhost:8003
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5

# ── Database ─────────────────────────────────────────────────────────────────────
# One database for every service, a schema each (users, reminders, notifications — created by
# devops/postgres's postgres-init). A service writes only its own schema.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_copilot

# ── Users Service ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-value
PASSWORD_PEPPER=change-me-to-a-different-long-random-value

# ── Notification Service ─────────────────────────────────────────────────────────
# Web Push identity (Notification Service). Generate once: npx web-push generate-vapid-keys.
# Changing the pair invalidates every stored browser subscription. Subject: a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@personal-copilot.invalid

# Admin seed — one-time only, see docs/users/environment.md. Leave both unset to skip.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-value

# ── Shared infra ────────────────────────────────────────────────────────────────
# BullMQ queues. Not published to the host — see docs/notifications/environment.md.
REDIS_URL=redis://localhost:6379
# Kafka events. Not published to the host either — a local run needs its own broker on 9092.
KAFKA_BROKERS=localhost:9092

# ── OpenTelemetry ────────────────────────────────────────────────────────────────
# OTEL_SERVICE_NAME is set per-app, not here. Override OTEL_EXPORTER_OTLP_ENDPOINT to
# localhost:4317 for a local (non-Docker) run — it defaults to the Docker network address.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
