# Shared local-dev defaults — every app's ConfigModule reads this one file from backend/'s cwd
# (npx nest start <app> is run from backend/). Copy to backend/.env for local (non-Docker) runs.
# Docker Compose supplies the container-network equivalents via devops/docker.env +
# devops/<service>/docker-compose.yml's `environment:` overrides instead of this file.

NODE_ENV=development

# ── Gateway (apps/gateway) ─────────────────────────────────────────────────────
# HTTP port. Only Gateway is ever reachable from outside the Docker network — reachable to your
# phone over Tailscale.
PORT=8000
# Internal-only URL Gateway forwards /auth/* to — never published to the host. (Telegram linking
# goes through Kafka instead — see KAFKA_BROKERS below and event-schemas.md.)
AUTH_SERVICE_URL=http://localhost:8001

# ── auth (apps/auth) ─────────────────────────────────────────────────────────────
# Must be identical between Gateway and Auth Service — Auth Service signs, Gateway verifies.
JWT_SECRET=change-me-to-a-long-random-value
# salt+pepper+SHA-256 password hashing — must stay identical across restarts or every existing
# password hash stops verifying.
PASSWORD_PEPPER=change-me-to-a-different-long-random-value
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_copilot

# ── telegram (apps/telegram) ───────────────────────────────────────────────────
# From @BotFather after creating the bot. Anyone can message the bot — it only does anything once
# a chat redeems a one-time code generated from the app's Settings screen (POST /telegram/link-code
# via Gateway), which links that chat to the app account that generated it.
TELEGRAM_BOT_TOKEN=change-me-to-your-bot-token

# ── Shared infra ────────────────────────────────────────────────────────────────
# Kafka broker (see devops/kafka/docker-compose.yml). Both apps/gateway (link-code request/reply)
# and apps/telegram (linking + message send/receive) produce and consume — see
# libs/kafka-contracts and event-schemas.md. comma-separated if more than one broker.
KAFKA_BROKERS=localhost:9092

# ── OpenTelemetry — see backend/libs/otel ────────────────────────────────────────
# OTEL_SERVICE_NAME must be unique per service — set per-app, not here. OTEL_EXPORTER_OTLP_ENDPOINT
# defaults to the Docker network address; override to localhost:4317 for a local (non-Docker) run.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
