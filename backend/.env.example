# Shared local-dev defaults, read by every app's ConfigModule (npx nest start <app> from
# backend/). Copy to backend/.env. See docs/gateway/environment.md and docs/auth/environment.md
# for what each variable does and why.

NODE_ENV=development

# ── Gateway ──────────────────────────────────────────────────────────────────────
# No PORT here — see docs/gateway/environment.md.
AUTH_SERVICE_URL=http://localhost:8001
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5

# ── Auth Service ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-value
PASSWORD_PEPPER=change-me-to-a-different-long-random-value
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_copilot

# Admin seed — one-time only, see docs/auth/environment.md. Leave both unset to skip.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-value

# ── Shared infra ────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── OpenTelemetry ────────────────────────────────────────────────────────────────
# OTEL_SERVICE_NAME is set per-app, not here. Override OTEL_EXPORTER_OTLP_ENDPOINT to
# localhost:4317 for a local (non-Docker) run — it defaults to the Docker network address.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
