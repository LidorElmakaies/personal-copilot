# Container-network overrides, layered on top of backend/.env's localhost-based defaults via
# `extends:` (see common.yml) — every service that talks to Kafka/Postgres/the OTel Collector
# inside the Docker network shares these, so they live here once instead of copy-pasted per
# service.
KAFKA_BROKERS=kafka:19092
DATABASE_URL=postgres://postgres:postgres@postgres:5432/personal_copilot
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
