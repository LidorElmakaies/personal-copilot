# Read by `docker compose` from devops/ — copy to devops/.env. See docs/devops/environment.md.

# HTTPS via devops/tailscale/serve.sh (GPS needs HTTPS on a phone). http://localhost:8000 for local-only use.
GATEWAY_PUBLIC_URL=https://my-pc.tailnet-name.ts.net:8443
JWT_SECRET=change-me-to-a-long-random-value
PASSWORD_PEPPER=change-me-to-a-different-long-random-value
