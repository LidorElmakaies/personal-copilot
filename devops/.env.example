# Read by `docker compose` from devops/ — copy to devops/.env. See docs/devops/environment.md.

# HTTPS via node devops/tailscale/serve.js (GPS needs HTTPS on a phone). http://localhost:8000 for local-only use.
GATEWAY_PUBLIC_URL=https://my-pc.tailnet-name.ts.net:8443
JWT_SECRET=change-me-to-a-long-random-value
# Optional: where the APK checks for updates (node devops/android/apk.js build); default
# https://<GATEWAY_PUBLIC_URL's host>/apk/.
# APK_REGISTRY_URL=
