# Read by `docker compose` from devops/ — copy to devops/.env. See docs/devops/environment.md.

# HTTPS via node devops/tailscale/serve.js. Optional for the APK (HTTPS when set): only its dormant
# login/account screens call Gateway.
GATEWAY_PUBLIC_URL=https://my-pc.tailnet-name.ts.net:8443
JWT_SECRET=change-me-to-a-long-random-value
# Where the APK checks for updates (node devops/android/apk.js build); default
# https://<GATEWAY_PUBLIC_URL's host>/apk/ — one of the two must be set.
# APK_REGISTRY_URL=
