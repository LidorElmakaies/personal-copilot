# Read automatically by `docker compose` when invoked from devops/ (its own directory) — copy to
# devops/.env and fill in. NOT shared with devops/observability's compose project (a separate
# directory/compose project); that stack doesn't need these.

# Your PC's Tailscale MagicDNS name (or Tailscale IP), reachable from your phone over the tailnet.
# Find it with `tailscale status` on this machine, or in the Tailscale admin console.
#
# Baked into the frontend's build (Expo inlines EXPO_PUBLIC_* vars into the client bundle) as the
# origin it calls for REST — port 8000.
GATEWAY_PUBLIC_URL=http://my-pc.tailnet-name.ts.net:8000

# JWT signing secret + password-hashing pepper (backend/libs/auth-kernel, apps/auth) — real random
# values, not the placeholders below, before this ever runs somewhere your phone actually reaches.
JWT_SECRET=change-me-to-a-long-random-value
PASSWORD_PEPPER=change-me-to-a-different-long-random-value
