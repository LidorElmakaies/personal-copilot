# Read by `docker compose -f docker-compose.cloud.yml` when invoked from devops/frontend/ — copy
# to devops/frontend/.env.cloud and fill in. Only for the standalone cloud/Hetzner deployment; the
# local/Tailscale stack (devops/.env) doesn't use this file.

# Public domain pointed at this VPS's IP — Caddy auto-provisions a Let's Encrypt cert for it and
# uses it as the frontend's own origin (same-origin proxying for /auth and /ws). Must be a real,
# publicly resolvable domain before this ever goes live — Let's Encrypt can't issue for a
# placeholder.
DOMAIN=example.com

# Port the SSH reverse tunnel forwards to on this VPS's loopback (`ssh -R
# <this port>:localhost:8000 <tunnel-user>@<this VPS>`, run from the home machine) — Gateway
# listens on 8000 there, Caddy proxies to it here as 127.0.0.1:<this port>. Pick any free
# unprivileged port; must match whatever the tunnel is actually started with.
GATEWAY_TUNNEL_PORT=8000
