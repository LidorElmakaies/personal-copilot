# See frontend/README.md#caddy-deployment for why this file is shaped the way it is.
{
	auto_https disable_redirects
}

{$SITE_ADDRESS::80} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	encode gzip

	# Every Gateway route, same-origin in the cloud deployment. A new top-level Gateway route needs
	# adding here.
	@gateway path /auth/* /users/* /calendar/* /reminders /reminders/* /notifications/* /realtime/* /admin/* /ws*
	handle @gateway {
		reverse_proxy {$GATEWAY_UPSTREAM:gateway:8000}
	}

	# APK registry (devops/data/apk, mounted at /apk — see devops/frontend/docker-compose.yml).
	# Absent where nothing is mounted (the cloud deployment): those paths just 404.
	redir /apk /apk/
	handle_path /apk/* {
		root * /apk
		header *.apk Content-Type application/vnd.android.package-archive
		# Always re-check the page and latest.json, so a new version shows at once.
		header /index.html Cache-Control no-cache
		header /latest.json Cache-Control no-cache
		header / Cache-Control no-cache
		file_server
	}

	handle {
		root * /srv
		# Expo Router's web export is a single-page app — any path that isn't a real static file
		# (e.g. a client-side route like /settings) falls back to index.html.
		try_files {path} /index.html
		file_server
	}
}
