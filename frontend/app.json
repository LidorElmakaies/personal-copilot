{
  "expo": {
    "name": "Personal Copilot",
    "slug": "personal-copilot",
    "scheme": "personalcopilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Personal Copilot uses your location to show Shabbat and holiday times for where you are."
        }
      ]
    ]
  }
}
